; https://editorconfig.org/

root = true

[*]
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
max_line_length = 100

[*.go]
indent_style = tab

; Generated by the nitpicker findings store: resolved.jsonl is one JSON record
; per line and findings.py rewrites the rest, so none of it can wrap.
[docs/audit/findings/**]
max_line_length = off

